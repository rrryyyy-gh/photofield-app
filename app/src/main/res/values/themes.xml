<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Theme - Minimal AppCompat, no Material3 XML dependencies -->
    <style name="Theme.PhotoFieldApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/md_theme_light_background</item>
    </style>

    <!-- Fullscreen theme for camera -->
    <style name="Theme.PhotoFieldApp.Fullscreen" parent="Theme.PhotoFieldApp">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>